{
  "extends": "typescript-config/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      // "collections/*": [
      //   "./.source/*"
      // ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
,
"next.config.mjs"
],
"exclude": [
"node_modules",
"dist"
]
}
