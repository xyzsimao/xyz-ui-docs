{
  "extends": "tsconfig/nextjs.json",
  "compilerOptions": {
    "strictNullChecks": false,
    "jsx": "react-jsx",
      "baseUrl": "./",
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "@/*": [
        "./*"
      ],
      "fumadocs-mdx:collections/*": [
        ".source/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "content/**/*.mdx",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "eslint.config.mjs",
    "components/registry/**/*"
  ]
}
