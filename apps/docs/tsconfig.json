{
  "extends": "typescript-config/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
      "baseUrl": ".",
      "ignoreDeprecations": "6.0",
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "@/*": [
        "./*"
      ],
      "xyzdocs-mdx:collections/*": [
        ".source/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "content/**/*.mdx",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "eslint.config.mjs",
    "components/registry/**/*"
  ]
}
