{
  "name": "xyzdocs-radix-ui",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "A simple example library built by tsdown",
  "exports": {
    "./provider/*": {
      "types": "./dist/provider/*.d.ts",
      "import": "./dist/provider/*.js"
    },
    "./layouts/shared": {
      "types": "./dist/layouts/shared/index.d.ts",
      "import": "./dist/layouts/shared/index.js"
    },
    "./layouts/home": {
      "types": "./dist/layouts/home/index.d.ts",
      "import": "./dist/layouts/home/index.js"
    },
    "./layouts/home/navbar": {
      "types": "./dist/layouts/home/navbar.d.ts",
      "import": "./dist/layouts/home/navbar.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:layout && pnpm build:tailwind",
    "build:layout": "tsdown",
    "build:tailwind": "tailwindcss -i css/style.css -o ./dist/style.css ",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-direction": "^1.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@xyzdocs/ui_base": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "xyzdocs-core": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "tsdown": "^0.19.0",
    "typescript": "^6.0.3",
    "typescript-config": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "*",
    "next": "16.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0",
    "xyzdocs-core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  }
}